# ==============================================================================
# ARGUS Sovereign OS — Environment Template (.env.example)
# ==============================================================================

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key
VITE_CLERK_FRONTEND_API=https://your-app.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_your_secret_key

# Sentry Crash Monitoring
VITE_SENTRY_DSN=https://your_sentry_dsn
SENTRY_AUTH_TOKEN=sntryu_your_token

# Resend Transactional Email
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=your_email@domain.com
RESEND_TO_EMAIL=your_email@domain.com

# PostHog Analytics
VITE_POSTHOG_KEY=phc_your_posthog_key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Supabase Backend
SUPABASE_ACCESS_TOKEN=sbp_your_supabase_token

# Upstash Redis
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Pinecone Vector DB
PINECONE_API_KEY=pcsk_your_pinecone_key

# Cloudflare
CLOUDFLARE_API_TOKEN=cfat_your_cloudflare_token
